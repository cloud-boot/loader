# TinyGo + lld-link build artefacts, ESP staging, and OVMF nvram snapshots.

# Compiled object files (TinyGo + clang).
*.o

# Linked EFI binaries (BOOTAA64.EFI / BOOTX64.EFI variants).
*.EFI

# Linker map and ESP images produced by the qemu-probe-* tasks.
*.map
esp.img
esp64.img
esp-stub.img
esp-*/

# OVMF non-volatile variable store snapshot.
ovmf_vars*.fd
nvram.bin

# Host-side build outputs (Go binaries, not EFI).
cmd/efivar-stage/efivar-stage

# qcow2 overlays created by qemu-{loader,disk-probe}-cloud-arm64.
cloud-overlay.qcow2

# Taskfile run-state.
.task/
/.freebsd-cache/
/.netbsd-cache/
*.qcow2
