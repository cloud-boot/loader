# TinyGo + lld-link build artefacts, ESP staging, and OVMF nvram snapshots.

# Compiled object files (TinyGo + clang).
*.o

# Linked EFI binaries (BOOTAA64.EFI / BOOTX64.EFI variants).
*.EFI

# Linker map and ESP images produced by the qemu-probe-* tasks.
*.map
esp.img
esp64.img
esp-stub.img
esp-*/

# OVMF non-volatile variable store snapshot.
ovmf_vars*.fd
nvram.bin

# Host-side build outputs (Go binaries, not EFI).
cmd/efivar-stage/efivar-stage

# qcow2 overlays created by qemu-{loader,disk-probe}-cloud-arm64.
cloud-overlay.qcow2

# Taskfile run-state.
.task/
/.freebsd-cache/
/.netbsd-cache/
*.qcow2

# Host binaries from `go build ./...` inside a cmd/ module land at
# cmd/<name>/<name> -- no extension, so no suffix rule catches them, and a rule
# that NAMES them stops working the day somebody renames a command.
#
# So this is a whitelist: ignore everything under cmd/*/ and let the sources
# back in by extension. If you add a genuinely new kind of source file here,
# add it below or git will quietly not see it.
/cmd/*/*
!/cmd/*/*.go
!/cmd/*/*.S
!/cmd/*/go.mod
!/cmd/*/go.sum
